# Supabase (frontend). Vite inlines these at build time; the anon key is public by design and only
# grants what the RLS policies allow (read everything, write positions and alert_configs).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Function secrets. These are NOT read from this file; set them on the project with
#   supabase secrets set ANTHROPIC_API_KEY=... FINNHUB_KEY=... GNEWS_API_KEY=... NEWS_API_KEY=... SEC_EDGAR_EMAIL=...
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the platform; do not set them.
#
# ANTHROPIC_API_KEY=sk-ant-...     # process-articles, fetch-sec-filings (required for any news-derived signal)
# FINNHUB_KEY=...                  # fetch-market-data (required), daily-snapshot (price enrichment, US tickers only)
# GNEWS_API_KEY=...                # fetch-news primary source, every run  https://gnews.io
# NEWS_API_KEY=...                 # fetch-news optional supplement for the broad queries  https://newsapi.org
# SEC_EDGAR_EMAIL=you@example.com  # fetch-insider-trades, fetch-sec-filings (contact address EDGAR requires in User-Agent)

# Optional switches
# ANTHROPIC_MODEL=claude-sonnet-5-5  # model used by process-articles / fetch-sec-filings (bulk extraction).
#                                    # Override: claude-opus-5-5 for higher-quality extraction at roughly 2x the token price.
# FN_AUTH_REQUIRED=true              # make every function reject calls without the service-role Authorization header.
#                                    # Set ONLY after supabase/migrations/00005_cron_jobs.sql is applied (see README runbook).
